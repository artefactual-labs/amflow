# This is used by GoReleaser.
FROM debian:trixie-20261104-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS final
# Keep the runtime and package snapshot in sync with Dockerfile.
RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/20261026T000000Z|g' \
      -e 's|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/20261026T000000Z|g' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      graphviz=2.42.4-3 \
      ca-certificates=20250419+deb13u1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --home-dir=/home/amflow --user-group --shell=/usr/sbin/nologin amflow
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/amflow /amflow
USER amflow
ENTRYPOINT ["/amflow"]
